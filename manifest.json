{
  "manifest_version": 3,
  "name": "SpeakWise - Pronunciation & Vocabulary Coach",
  "version": "1.4.0",
  "description": "Learn pronunciation, vocabulary, IPA phonetics, definitions, crop/snip screen OCR for images/PDFs, and practice speaking with speech recognition scoring.",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "commands": {
    "speakwise-read-selection": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Phát âm ngay đoạn văn đang bôi đen"
    },
    "speakwise-toggle-panel": {
      "suggested_key": {
        "default": "Alt+W",
        "mac": "Alt+W"
      },
      "description": "Bật/tắt thanh bên SpeakWise"
    },
    "speakwise-capture-ocr": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Alt+Q"
      },
      "description": "Chụp quét chữ trên màn hình (PDF, Ảnh trực tiếp)"
    }
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
